<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hail of Blades"
            android:textSize="28sp"
            android:layout_gravity="center"
            android:paddingBottom="24dp" />

        <TextView android:text="توکن گیت‌هاب" />
        <EditText
            android:id="@+id/tokenInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPassword" />

        <TextView android:text="مالک ریپازیتوری" android:layout_marginTop="12dp" />
        <EditText
            android:id="@+id/ownerInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView android:text="نام ریپازیتوری" android:layout_marginTop="12dp" />
        <EditText
            android:id="@+id/repoInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="directandyt" />

        <TextView android:text="پروکسی (اختیاری)" android:layout_marginTop="12dp" />
        <EditText
            android:id="@+id/proxyInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="http://proxy:8080" />

        <Button
            android:id="@+id/saveSettingsButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ذخیره تنظیمات"
            android:layout_marginTop="12dp" />

        <TextView android:text="آدرس فایل (URL)" android:layout_marginTop="24dp" />
        <EditText
            android:id="@+id/urlInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView android:text="نام فایل خروجی (اختیاری)" android:layout_marginTop="12dp" />
        <EditText
            android:id="@+id/filenameInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="مثال: myvideo.mp4" />

        <Button
            android:id="@+id/startButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="شروع دانلود"
            android:layout_marginTop="16dp" />

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/logText"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:background="#EEEEEE"
            android:padding="8dp"
            android:scrollbars="vertical"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/clearLogButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="پاک کردن لاگ"
            android:layout_gravity="end" />

        <Button
            android:id="@+id/manageFoldersButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="مدیریت پوشه‌های قدیمی در ریپازیتوری"
            android:layout_marginTop="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="16dp">

            <TextView
                android:id="@+id/telegramLink"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📱 @Hailofblades"
                android:textColor="#0088cc"
                android:padding="8dp"
                android:clickable="true" />

            <TextView android:text="  |  " />

            <TextView
                android:id="@+id/githubLink"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🐙 GitHub"
                android:textColor="#AAAAAA"
                android:padding="8dp"
                android:clickable="true" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
