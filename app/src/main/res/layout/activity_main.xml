<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="#0F0F0F">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hail of Blades"
            android:textSize="28sp"
            android:textColor="#9B2C2C"
            android:paddingBottom="24dp" />

        <!-- بخش تنظیمات -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp"
            android:padding="16dp"
            android:background="#1E1E1E">

            <TextView
                android:text="تنظیمات"
                android:textColor="#9B2C2C"
                android:textSize="18sp"
                android:layout_marginBottom="12dp" />

            <TextView android:text="توکن گیت‌هاب" android:textColor="#B0B0B0" />
            <EditText
                android:id="@+id/tokenInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:hint="ghp_..."
                android:textColor="#FFFFFF" />

            <TextView
                android:text="مالک ریپازیتوری"
                android:textColor="#B0B0B0"
                android:layout_marginTop="12dp" />
            <EditText
                android:id="@+id/ownerInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#FFFFFF" />

            <TextView
                android:text="نام ریپازیتوری"
                android:textColor="#B0B0B0"
                android:layout_marginTop="12dp" />
            <EditText
                android:id="@+id/repoInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="directandyt"
                android:textColor="#FFFFFF" />

            <TextView
                android:text="پروکسی (اختیاری)"
                android:textColor="#B0B0B0"
                android:layout_marginTop="12dp" />
            <EditText
                android:id="@+id/proxyInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="http://proxy:8080"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/saveSettingsButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ذخیره تنظیمات"
                android:layout_marginTop="12dp" />
        </LinearLayout>

        <!-- بخش دانلود -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp"
            android:padding="16dp"
            android:background="#1E1E1E">

            <TextView
                android:text="دانلود فایل"
                android:textColor="#9B2C2C"
                android:textSize="18sp"
                android:layout_marginBottom="12dp" />

            <TextView android:text="آدرس فایل (URL)" android:textColor="#B0B0B0" />
            <EditText
                android:id="@+id/urlInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="https://..."
                android:textColor="#FFFFFF" />

            <TextView
                android:text="نام فایل خروجی (اختیاری)"
                android:textColor="#B0B0B0"
                android:layout_marginTop="12dp" />
            <EditText
                android:id="@+id/filenameInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="مثال: myvideo.mp4 — حتماً پسوند را وارد کنید"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/startButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="شروع دانلود"
                android:layout_marginTop="12dp" />

            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/logText"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:background="#0F0F0F"
                android:padding="8dp"
                android:scrollbars="vertical"
                android:gravity="top"
                android:textColor="#B0B0B0"
                android:layout_marginTop="12dp" />

            <Button
                android:id="@+id/clearLogButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="پاک کردن لاگ"
                android:layout_gravity="end" />
        </LinearLayout>

        <!-- مدیریت پوشه‌ها -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp"
            android:padding="16dp"
            android:background="#1E1E1E">

            <Button
                android:id="@+id/manageFoldersButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="مدیریت پوشه‌های قدیمی در ریپازیتوری" />
        </LinearLayout>

        <!-- لینک‌ها -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:padding="8dp">

            <TextView
                android:id="@+id/telegramLink"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📱 @Hailofblades"
                android:textColor="#0088cc"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="  |  "
                android:textColor="#B0B0B0" />

            <TextView
                android:id="@+id/githubLink"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🐙 GitHub"
                android:textColor="#AAAAAA"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
