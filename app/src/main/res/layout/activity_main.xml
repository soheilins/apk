<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hail of Blades"
            android:textSize="28sp"
            android:layout_gravity="center" />

        <TextView android:text="GitHub Token" />
        <EditText
            android:id="@+id/tokenInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPassword" />

        <TextView android:text="Repo Owner" android:layout_marginTop="12dp" />
        <EditText
            android:id="@+id/ownerInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView android:text="Repo Name" android:layout_marginTop="12dp" />
        <EditText
            android:id="@+id/repoInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="directandyt" />

        <TextView android:text="Proxy (optional)" android:layout_marginTop="12dp" />
        <EditText
            android:id="@+id/proxyInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="http://proxy:8080" />

        <Button
            android:id="@+id/saveSettingsButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Save Settings"
            android:layout_marginTop="12dp" />

        <TextView android:text="File URL" android:layout_marginTop="24dp" />
        <EditText
            android:id="@+id/urlInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView android:text="Output Filename (optional)" android:layout_marginTop="12dp" />
        <EditText
            android:id="@+id/filenameInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g., myfile.mp4" />

        <Button
            android:id="@+id/startButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Start Download"
            android:layout_marginTop="16dp" />

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/logText"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:background="#EEEEEE"
            android:padding="8dp"
            android:scrollbars="vertical"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/clearLogButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Clear Log"
            android:layout_gravity="end" />

        <Button
            android:id="@+id/manageFoldersButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Manage Old Folders"
            android:layout_marginTop="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="16dp">

            <TextView
                android:id="@+id/telegramLink"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@Hailofblades"
                android:textColor="#0088cc"
                android:padding="8dp"
                android:clickable="true" />

            <TextView android:text=" | " />

            <TextView
                android:id="@+id/githubLink"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GitHub"
                android:textColor="#AAAAAA"
                android:padding="8dp"
                android:clickable="true" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
